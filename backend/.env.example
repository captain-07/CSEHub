SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=False

# Backend domains/hosts (comma-separated)
ALLOWED_HOSTS=csehub.onrender.com,localhost,127.0.0.1

# Preferred on Render
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local fallback when DATABASE_URL is not provided
DB_NAME=csehub_db
DB_USER=postgres
DB_PASSWORD=your-local-db-password
DB_HOST=localhost
DB_PORT=5432

# Frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
SECURE_SSL_REDIRECT=True

# Supabase project URL. The only value auth needs: access tokens are verified
# against {SUPABASE_URL}/auth/v1/.well-known/jwks.json, so no JWT secret is
# required server-side. The browser only ever holds the publishable key.
SUPABASE_URL=https://yourproject.supabase.co

# Public origin to prefix uploaded article image URLs with. Leave blank unless
# the API sits behind a proxy whose request host differs from the address users
# browse to. Only used for local filesystem storage.
API_PUBLIC_BASE_URL=

# --- Article image storage -------------------------------------------------
# Leave USE_REMOTE_STORAGE=False for local development: images go to
# backend/media/ and Django serves them. Set it to True in production so images
# are stored remotely and served by that provider's CDN.
#
# IMAGE_STORAGE_PROVIDER chooses the backend once USE_REMOTE_STORAGE is True:
#   cloudinary  Cloudinary's CDN. Current provider. Free tier is 25 credits/month
#               shared across storage, bandwidth and transformations.
#   supabase    Supabase Storage over the S3 protocol. Legacy — this project used
#               it first and is now moving to Cloudinary. Kept only as a rollback
#               path. R2, Spaces and MinIO also work under this name by editing
#               the endpoint.
#
# Migrating Supabase -> Cloudinary, in this order (the order is not negotiable):
#   1. Fill in the CLOUDINARY_* values below.
#   2. python manage.py migrate_images_to_cloudinary            # dry run
#   3. python manage.py migrate_images_to_cloudinary --apply    # copies the bytes
#   4. python manage.py rewrite_image_urls \
#          --from <supabase-public-bucket-base> \
#          --to https://res.cloudinary.com/<cloud-name>/image/upload/articles \
#          --strip-extension                                    # dry run
#   5. ...same command with --apply                              # repoints URLs
#   6. Only then set USE_REMOTE_STORAGE=True (with
#      IMAGE_STORAGE_PROVIDER=cloudinary) and restart.
#
# Step 3 copies files and step 5 repoints the URLs stored in article JSON.
# Running 5 before 3 leaves every published article pointing at images that do
# not exist yet. --strip-extension is required: Cloudinary keeps the format in
# the asset rather than the public id, so without it you get doubled
# `a.webp.webp` URLs that 404.
#
# --to is required as well. Without it `rewrite_image_urls` derives the
# replacement from whichever storage is *currently* configured; while the
# provider is still Supabase that resolves back to the old base and the rewrite
# silently does nothing. `migrate_images_to_cloudinary --apply` prints the exact
# step 4/5 commands with the correct --to value.
#
# Note that `featured_image` and Editor.js image URLs are stored as absolute
# strings in the database, not as storage keys, so they are NOT provider-agnostic.
# A provider switch without step 5 leaves the old host in published content.
USE_REMOTE_STORAGE=False
IMAGE_STORAGE_PROVIDER=cloudinary

# --- Cloudinary ------------------------------------------------------------
# Settings -> API Keys in the Cloudinary console. The API secret is the admin
# credential: it can list and delete every asset in the account, so it belongs
# only in this file.
#
# All three are required. settings.py refuses to start on `cloudinary` with a
# missing or placeholder value rather than failing later on an upload.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudinary's Free plan rejects image uploads over 10 MB. The next paid tier
# raises this to 20 MB. apps.articles.media clamps its own animated-image
# ceiling against this so an accepted upload cannot fail at the provider.

# --- Supabase Storage (legacy, rollback only) ------------------------------
# Still set after moving to Cloudinary, because `migrate_images_to_cloudinary`
# reads SUPABASE_PROJECT_REF / SUPABASE_STORAGE_BUCKET to locate the old bucket.
# Safe to delete once no article references the old bucket.
#
# To re-enable Supabase Storage instead:
#   1. Create a PUBLIC bucket (e.g. "articles") in Storage -> Buckets.
#   2. Storage -> S3 Settings -> enable the S3 protocol and create a key pair.
#   3. Copy the project ref and the access key / secret key below, and set
#      IMAGE_STORAGE_PROVIDER=supabase.
#
# The S3 keys are NOT the service_role key and NOT the publishable key. They
# bypass RLS and grant full storage access, so they belong only in this file.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_STORAGE_BUCKET=articles
SUPABASE_S3_ENDPOINT_URL=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
SUPABASE_S3_REGION=your-project-ref

# --- Image optimisation ----------------------------------------------------
# Uploads are downscaled and re-encoded to WebP before storage. The article
# reading column is ~800px wide, so 1600 covers 2x displays. Output is
# typically 70-90% smaller, which is what keeps bandwidth inside the free tier.
IMAGE_MAX_DIMENSION=1600
IMAGE_WEBP_QUALITY=82
IMAGE_WEBP_METHOD=6
# Skip re-encoding when it would save less than this fraction, so a PNG that is
# already efficient is stored as-is rather than mangled by a lossy round-trip.
IMAGE_MIN_SAVINGS_RATIO=0.10

# Optional RAG integration. Required only for ingestion and article chat.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite


DJANGO_SUPERUSER_EMAIL=admin@csehub.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
