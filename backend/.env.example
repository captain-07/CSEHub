SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=False

# Backend domains/hosts (comma-separated)
ALLOWED_HOSTS=csehub.onrender.com,localhost,127.0.0.1

# Preferred on Render
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local fallback when DATABASE_URL is not set
DB_NAME=csehub_db
DB_USER=postgres
DB_PASSWORD=your-local-db-password
DB_HOST=localhost
DB_PORT=5432

# Frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
SECURE_SSL_REDIRECT=True

# Supabase project URL — the only value auth needs. Tokens are verified against
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json, so no JWT secret is required.
SUPABASE_URL=https://yourproject.supabase.co

# Public origin for uploaded image URLs, only if the request host differs from
# the address users browse to. Local filesystem storage only.
API_PUBLIC_BASE_URL=

# --- Article image storage -------------------------------------------------
# False = images in backend/media/ (no credentials needed, lost on redeploy).
# True  = images in Cloudinary, served from its CDN.
USE_REMOTE_STORAGE=False

# Cloudinary credentials, from Settings -> API Keys in the console. Required
# when USE_REMOTE_STORAGE=True; startup fails on a missing or placeholder value.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Image optimisation ----------------------------------------------------
# Uploads are downscaled and re-encoded to WebP before storage.
IMAGE_MAX_DIMENSION=1600
IMAGE_WEBP_QUALITY=82
IMAGE_WEBP_METHOD=6
# Skip re-encoding when it would save less than this fraction, so an already
# efficient image is stored as-is rather than mangled by a lossy round-trip.
IMAGE_MIN_SAVINGS_RATIO=0.10

# Optional RAG integration. Required only for ingestion and article chat.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

DJANGO_SUPERUSER_EMAIL=admin@csehub.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
