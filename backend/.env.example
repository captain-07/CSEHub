SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=False

# Backend domains/hosts (comma-separated)
ALLOWED_HOSTS=csehub.onrender.com,localhost,127.0.0.1

# Preferred on Render
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local fallback when DATABASE_URL is not provided
DB_NAME=csehub_db
DB_USER=postgres
DB_PASSWORD=your-local-db-password
DB_HOST=localhost
DB_PORT=5432

# Frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
SECURE_SSL_REDIRECT=True

# Supabase project URL. The only value auth needs: access tokens are verified
# against {SUPABASE_URL}/auth/v1/.well-known/jwks.json, so no JWT secret is
# required server-side. The browser only ever holds the publishable key.
SUPABASE_URL=https://yourproject.supabase.co

# Public origin to prefix uploaded article image URLs with. Leave blank unless
# the API sits behind a proxy whose request host differs from the address users
# browse to. Only used for local filesystem storage.
API_PUBLIC_BASE_URL=

# --- Article image storage -------------------------------------------------
# Leave USE_REMOTE_STORAGE=False for local development: images go to
# backend/media/ and Django serves them. Set it to True in production so images
# are stored in a Supabase Storage bucket and served by its CDN.
#
# To enable Supabase Storage:
#   1. Create a PUBLIC bucket (e.g. "articles") in Storage -> Buckets.
#   2. Storage -> S3 Settings -> enable the S3 protocol and create a key pair.
#   3. Copy the project ref and the access key / secret key below.
#
# The S3 keys are NOT the service_role key and NOT the publishable key. They
# bypass RLS and grant full storage access, so they belong only in this file.
USE_REMOTE_STORAGE=False
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_STORAGE_BUCKET=articles
SUPABASE_S3_ENDPOINT_URL=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
SUPABASE_S3_REGION=your-project-ref

# --- Image optimisation ----------------------------------------------------
# Uploads are downscaled and re-encoded to WebP before storage. The article
# reading column is ~800px wide, so 1600 covers 2x displays. Output is
# typically 70-90% smaller, which is what keeps bandwidth inside the free tier.
IMAGE_MAX_DIMENSION=1600
IMAGE_WEBP_QUALITY=82
IMAGE_WEBP_METHOD=6

# Optional RAG integration. Required only for ingestion and article chat.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite


DJANGO_SUPERUSER_EMAIL=admin@csehub.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
